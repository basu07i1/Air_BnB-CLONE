<% layout("/layouts/boilerplate") %>
<body>
    <h3>Listing Details :</h3>
   
    <ul>
        <li><%= listing.title %></li>

<button
    type="button"
    id="track-listing-view"
    data-listing-id="<%= listing._id %>"
    data-listing-name="<%= listing.title %>"
>
    Track Listing View
</button>

<script>
    document
        .getElementById("track-listing-view")
        .addEventListener("click", function () {
            if (window.posthog) {
                posthog.capture("listing_viewed", {
                    listing_id: this.dataset.listingId,
                    listing_name: this.dataset.listingName
                });
            }
        });
</script>

        <li><%= listing.description %></li>
        <li>  &#8377;  <%= listing.price.toLocaleString("en-IN") %></li>
        <li><%= listing.location %></li>
        <li><%= listing.country %></li>
    </ul>
    <br />
    <a href="/listings/<%= listing._id %>/edit">Edit this Listing</a>
    <br><br>
    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button>Delete this listing</button>
    </form>
</body>
